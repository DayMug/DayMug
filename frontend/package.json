{
  "name": "frontend",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm sync:office && vite",
    "typecheck": "vue-tsc --noEmit",
    "build:bundle": "pnpm sync:office && vite build",
    "build": "pnpm run typecheck && pnpm run build:bundle",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html}\"",
    "test": "vitest run",
    "test:fast": "vitest run --project node --project ui",
    "test:unit": "vitest run --project node",
    "test:ui": "vitest run --project ui",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "i18n:check": "node scripts/check-i18n.mjs",
    "api-contract:check": "node scripts/check-api-contract.mjs",
    "sync:office": "node scripts/sync-casual-office.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@material-symbols/font-400": "^0.47.4",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^20.8.9",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "@casualoffice/docs": "1.4.2",
    "@casualoffice/sheets": "0.20.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@tailwindcss/vite": "^4.2.2",
    "@vueuse/core": "^14.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.11.1",
    "katex": "0.16.47",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.1",
    "markdown-it-cjk-friendly": "^3.0.0",
    "mermaid": "^11.15.0",
    "pptx-preview": "^1.0.7",
    "reka-ui": "^2.9.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.2",
    "vue-router": "^5.0.4",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "allowBuilds": [
      "vue-demi"
    ]
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "engines": {
    "pnpm": ">=10"
  }
}
